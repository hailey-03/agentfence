# 필수
DATABASE_URL=mariadb+pymysql://app:app_password@localhost:3306/app_db?charset=utf8mb4
JWT_SECRET_KEY=change-me-to-a-long-random-string   # 꼭 바꿀 것. 비어 있으면 앱이 뜨지 않음
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 실제 Bedrock 실행 시
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=1

# 선택
LLM_MODE=fake               # fake: Bedrock 없이 흐름 확인 / bedrock: 실제 호출
PLANNER_TOOL_CHOICE=tool    # 모델이 특정 도구 강제를 지원하지 않으면 any
