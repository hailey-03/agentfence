# 필수 (실제 Bedrock 실행 시)
JWT_SECRET=change-me-to-a-long-random-string
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=1

# 선택
LLM_MODE=fake               # fake: Bedrock 없이 흐름 확인 / bedrock: 실제 호출
PLANNER_TOOL_CHOICE=tool    # 모델이 특정 도구 강제를 지원하지 않으면 any
DATABASE_URL=sqlite:///./agentfence.db
